# BXL coverage — discover + run + report for all PURE-LOGIC crates under //src.
#
# Run:  buck2 bxl -j 6 //tools/coverage:cov.bxl:cov
#       buck2 bxl -j 6 //tools/coverage:cov.bxl:cov -- --crate control-plane/memory
# Prints the path to the `combined` output dir (lcov.info + report.txt) on the
# last line. A per-crate dir is also materialized for each crate covered.
#
# No --config flag: instrumentation is turned on by applying the
# `//tools/coverage:coverage_enabled` constraint_value as a CONFIGURATION
# MODIFIER when configuring the rust_test targets (the toolchain select()s on
# it). So only this build path is instrumented; normal builds / `buck2 test`
# are byte-for-byte unchanged.
#
# SCOPE: pure-logic crates only. Fixture crates (postgres, worker, ingest,
# query-api) boot initdb/postgres/duckdb and can't run instrumented under this
# path; Task 3 adds them with local_only. Fixtures are identified by PACKAGE:
# any rust_test whose package is one of FIXTURE_PACKAGES is skipped. We tried
# classifying by the `remote_execution` attr (the `loom_fixture_test` macro sets
# it to "disabled"), but that is UNRELIABLE: not every fixture test goes through
# the macro — e.g. //src/services/ingest:materialize is a bare rust_test with no
# such attr, yet it boots a DB and fails on RE. Package membership is the robust
# signal, so that is what we use. Pure-logic actions are NOT pinned local_only,
# so they are RE-eligible.
#
# DETERMINISTIC OBJECT ORDERING (critical for a reproducible %):
#   Each rust_test binary statically links the whole crate library, so the same
#   source (e.g. page.rs) is instrumented into several test objects. The merged
#   profile carries every counter, but `llvm-cov` attributes each function to the
#   FIRST object on its command line that defines it ("N functions have
#   mismatched data" is this dedup speaking). A binary that links a source but
#   never exercises it can therefore MASK a sibling that does, shifting the
#   reported %. We do NOT try to maximize the number; we make it REPRODUCIBLE by
#   sorting each group's binaries with a single stable key: the test label name
#   (lexicographic). Same inputs -> same object order -> same %, every run.
#
#   Linked-but-not-fixture deps still surface: a pure-logic test that links
#   another pure-logic lib (e.g. memory's tests link :core) reports that lib's
#   sources too, at whatever % those tests happen to drive. That's a legitimate
#   coverage signal (not fixture noise), so we keep it — only the fixture/testkit
#   library objects are stripped, by IGNORE below. Consequence: a single-crate
#   run (`--crate control-plane/memory`) shows core/* rows; the full run folds
#   them into core's own (higher) numbers via the combined merge.
#
# WORKING BXL API (verified against the pinned buck2):
#   - Entry:              cov = bxl_main(impl=_cov_impl, cli_args={"crate": ...})
#   - Optional CLI arg:   cli_args.option(cli_args.string()) ; read ctx.cli_args.crate
#   - Action handle:      ba = ctx.bxl_actions(); actions = ba.actions
#   - String label->ct:   ctx.configured_targets("toolchains//:llvm-x86_64-linux")
#   - Discover:           ctx.uquery().kind("rust_test", ctx.uquery().eval("//path/..."))
#                         (UNCONFIGURED nodes, alphabetical; node.label is usable)
#   - Package of a node:  str(node.label.package) (used to skip fixtures)
#   - Apply a modifier:   ctx.configured_targets(node.label, modifiers = [...])
#   - Configured -> out:  ctx.analysis(ct).providers()[DefaultInfo].default_outputs[0]
#   - Declare outputs:    actions.declare_output("name") / declare_output("d", dir=True)
#   - Run an action:      actions.run(cmd_args([...]), category=, identifier=)
#   - Materialize+print:  ctx.output.print(ctx.output.ensure(out_dir))

# Applied as a configuration modifier so the test binaries (and the lib deps
# they statically link) compile with -Cinstrument-coverage — no global config.
COVERAGE_MODIFIERS = ["root//tools/coverage:coverage_enabled"]

# Fixture crates: boot initdb/postgres/duckdb, can't run instrumented on RE.
# Classified by PACKAGE (robust) rather than by the remote_execution attr — see
# the SCOPE note above for why the attr is unreliable.
FIXTURE_PACKAGES = [
    "src/control-plane/postgres",
    "src/control-plane/worker",
    "src/services/ingest",
    "src/services/query-api",
]

# Crates we never want to attribute coverage to, even though a pure-logic test
# binary STATICALLY LINKS them as library deps (so their objects carry counters).
# llvm-cov would otherwise emit 0% rows for every linked-but-unexercised source —
# e.g. //src/services/runtime:config links :runtime -> postgres -> testkit, so
# control-plane/postgres/src/* and control-plane/testkit/* would leak into the
# report at 0%. We drop those source paths by -ignore-filename-regex. NOTE the
# regex matches the EMBEDDED source path (the lcov `SF:` path), which keeps its
# leading `src/` (e.g. `src/control-plane/postgres/src/acl.rs`) — even though the
# llvm-cov *report* display strips a common prefix. So anchor on the full
# `src/<package>/` form. (`testkit` is the shared contract harness, not a
# pure-logic crate under test.)
_IGNORE_PACKAGES = FIXTURE_PACKAGES + ["src/control-plane/testkit"]

def _ignore_regex():
    parts = ["^/", "^third-party/", "/tests/"]
    for pkg in _IGNORE_PACKAGES:
        parts.append("^" + pkg + "/")
    return "|".join(parts)

IGNORE = _ignore_regex()

def _is_fixture(node):
    return str(node.label.package) in FIXTURE_PACKAGES

def _emit(ctx, actions, llvm, run_one, report_sh, name, nodes):
    # Sort by label name: single stable deterministic key -> reproducible object
    # order -> reproducible coverage %. See the ordering note at the top.
    bins = []
    profraws = []
    for node in sorted(nodes, key = lambda n: n.label.name):
        ct = ctx.configured_targets(node.label, modifiers = COVERAGE_MODIFIERS)
        bin = ctx.analysis(ct).providers()[DefaultInfo].default_outputs[0]
        pr = actions.declare_output("prof/{}/{}.profraw".format(name, node.label.name))
        actions.run(
            cmd_args(["bash", run_one, pr.as_output(), bin]),
            category = "coverage_run",
            identifier = "{}:{}".format(name, node.label.name),
        )
        bins.append(bin)
        profraws.append(pr)

    out_dir = actions.declare_output(name, dir = True)
    profdata = actions.declare_output("{}.profdata".format(name))
    args = cmd_args(["bash", report_sh, cmd_args(llvm), out_dir.as_output(), profdata.as_output(), IGNORE])
    args.add(profraws)
    args.add("--")
    args.add(bins)
    actions.run(args, category = "coverage_report", identifier = name)
    return out_dir, bins, profraws

def _cov_impl(ctx):
    bxl_actions = ctx.bxl_actions()
    actions = bxl_actions.actions

    llvm = ctx.analysis(ctx.configured_targets("toolchains//:llvm-x86_64-linux")).providers()[DefaultInfo].default_outputs[0]
    run_one = ctx.analysis(ctx.configured_targets("//tools/coverage:run-one")).providers()[DefaultInfo].default_outputs[0]
    report_sh = ctx.analysis(ctx.configured_targets("//tools/coverage:report-sh")).providers()[DefaultInfo].default_outputs[0]

    crate = ctx.cli_args.crate
    universe = "//src/{}/...".format(crate) if crate else "//src/..."

    tests = ctx.uquery().kind("rust_test", ctx.uquery().eval(universe))

    # Group pure-logic tests by crate package; skip fixtures.
    groups = {}
    for node in tests:
        if _is_fixture(node):
            continue
        pkg = str(node.label.package)
        groups.setdefault(pkg, []).append(node)

    all_bins = []
    all_profraws = []
    # Iterate packages in sorted order for determinism.
    for pkg in sorted(groups.keys()):
        name = pkg.replace("/", "_")
        out_dir, bins, profraws = _emit(ctx, actions, llvm, run_one, report_sh, name, groups[pkg])
        ctx.output.print("CRATE {} -> {}".format(pkg, ctx.output.ensure(out_dir)))
        all_bins.extend(bins)
        all_profraws.extend(profraws)

    # One combined report across ALL pure-logic bins/profraws. Bins are appended
    # in sorted-package then sorted-label order, so the combined object order is
    # deterministic too.
    combined_dir = actions.declare_output("combined", dir = True)
    combined_profdata = actions.declare_output("combined.profdata")
    args = cmd_args(["bash", report_sh, cmd_args(llvm), combined_dir.as_output(), combined_profdata.as_output(), IGNORE])
    args.add(all_profraws)
    args.add("--")
    args.add(all_bins)
    actions.run(args, category = "coverage_report", identifier = "combined")

    ctx.output.print(ctx.output.ensure(combined_dir))

cov = bxl_main(
    impl = _cov_impl,
    cli_args = {
        "crate": cli_args.option(cli_args.string()),
    },
)
