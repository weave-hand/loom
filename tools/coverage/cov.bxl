# BXL coverage — discover + run + report for ALL crates under //src.
#
# Run:  buck2 bxl -j 6 //tools/coverage:cov.bxl:cov
#       buck2 bxl -j 6 //tools/coverage:cov.bxl:cov -- --crate control-plane/postgres
# Prints the path to the `combined` output dir (lcov.info + report.txt) on the
# last line. A per-crate dir is also materialized for each crate covered.
#
# No --config flag: instrumentation is turned on by applying the
# `//tools/coverage:coverage_enabled` constraint_value as a CONFIGURATION
# MODIFIER when configuring the rust_test targets (the toolchain select()s on
# it). So only this build path is instrumented; normal builds / `buck2 test`
# are byte-for-byte unchanged.
#
# SCOPE: all crates, pure-logic AND fixture — UNIFORMLY, with NO classification.
# Every test *run* action is pinned local_only and handed the postgres/duckdb env
# (built once from the source targets `loom_fixture_test` uses — see FIXTURE_ENV,
# mirrored from src/control-plane/postgres/defs.bzl). Why uniform instead of
# classifying fixture vs pure-logic:
#   - Fixture tests boot initdb/postgres/duckdb and can't run as root on RE.
#   - Heavy instrumented binaries (e.g. //src/services/datafusion-io:write) fail
#     to flush their profraw on RE even though they need no DB — so RE is
#     unreliable for the runs generally, not just for fixtures.
#   - The DB env is harmless to pure-logic tests (they never read it).
#   - Any hardcoded fixture/first-party package list rots when a crate is added
#     (it did: datafusion-io + transform broke a list-based version). Both the
#     run treatment AND the per-crate filtering now derive everything from the
#     discovered tests, so new crates are picked up automatically.
# Only the `run_one` action is local; the build and the report.sh/merge actions
# (just llvm-profdata/llvm-cov, no DB) stay RE-eligible.
#
# DETERMINISTIC OBJECT ORDERING (critical for a reproducible %):
#   Each rust_test binary statically links the whole crate library, so the same
#   source (e.g. page.rs) is instrumented into several test objects. The merged
#   profile carries every counter, but `llvm-cov` attributes each function to the
#   FIRST object on its command line that defines it ("N functions have
#   mismatched data" is this dedup speaking). A binary that links a source but
#   never exercises it can therefore MASK a sibling that does, shifting the
#   reported %. We do NOT try to maximize the number; we make it REPRODUCIBLE by
#   sorting each group's binaries with a single stable key: the test label name
#   (lexicographic). Same inputs -> same object order -> same %, every run.
#
# PER-CRATE-SCOPED FILTERING (replaces the old single global IGNORE):
#   Every rust_test statically links its crate lib AND that lib's first-party
#   deps, so one binary's profile carries counters for OTHER crates' sources too
#   (e.g. memory's tests link :core; runtime links postgres/testkit). The old
#   approach used ONE global -ignore-filename-regex that stripped the fixture
#   packages + testkit — fine while fixtures were unmeasured, but now that we run
#   the fixture crates that global strip would HIDE their real coverage. So we
#   scope per crate instead:
#     - A per-crate report for crate X uses `_ignore_for(X)`: a regex that
#       excludes EVERY other first-party package's `src/<pkg>/`, plus third-party,
#       absolute/stdlib paths, and any `/tests/`. Result: crate X's report shows
#       ONLY `src/<X>/src/**` rows (including the fixture crates' own coverage),
#       never linked-but-unexercised siblings at 0%.
#     - The COMBINED report uses `_combined_ignore()`: keep ALL 7 crates' own
#       src, exclude only third-party, absolute/stdlib, `/tests/`, and testkit
#       (the shared contract harness, not a measured crate).
#   The regex matches the EMBEDDED source path (the lcov `SF:` path), which keeps
#   its leading `src/` (e.g. `src/control-plane/postgres/src/acl.rs`) — even
#   though the llvm-cov *report* display strips a common prefix. So anchor on the
#   full `src/<package>/` form.

# Applied as a configuration modifier so the test binaries (and the lib deps
# they statically link) compile with -Cinstrument-coverage — no global config.
COVERAGE_MODIFIERS = ["root//tools/coverage:coverage_enabled"]

# NO hardcoded crate lists. Every test runs the same way — local_only with the
# postgres/duckdb env injected universally (pure-logic tests ignore the env). This
# is deliberately uniform rather than classifying fixture vs pure-logic:
#   - Fixture tests (postgres/duckdb) MUST run local (can't run as root on RE).
#   - Heavy instrumented binaries (e.g. datafusion-io) fail to flush their profraw
#     on RE, so even "pure-logic" tests are unreliable on RE under instrumentation.
#   - Any hardcoded fixture/first-party package list rots the moment a crate is
#     added (it did — datafusion-io/transform broke a list-based version).
# So: run everything local, inject the env everywhere, and DERIVE the first-party
# package set from the discovered tests (see `all_pkgs` in _cov_impl).

# testkit is the one first-party lib that is a shared contract harness, never a
# measured crate, and has no rust_test of its own (so it won't appear in the
# discovered package set) — exclude it from reports explicitly.
_TESTKIT = "src/control-plane/testkit"

# Common exclusions for every report: stdlib/absolute paths, third-party crates,
# and test sources.
_COMMON_IGNORE = ["^/", "^third-party/", "/tests/"]

def _ignore_for(keep_pkg, all_pkgs):
    # Per-crate scope: exclude every other discovered package (+ testkit) so the
    # report shows only `src/<keep_pkg>/src/**`. `all_pkgs` is derived from the
    # tests actually present, so this needs no maintenance as crates are added.
    parts = list(_COMMON_IGNORE)
    for pkg in all_pkgs:
        if pkg != keep_pkg:
            parts.append("^" + pkg + "/")
    parts.append("^" + _TESTKIT + "/")
    return "|".join(parts)

def _combined_ignore():
    # Combined scope: keep every measured crate's src; drop only testkit among
    # the first-party packages (plus the common exclusions).
    parts = list(_COMMON_IGNORE)
    parts.append("^" + _TESTKIT + "/")
    return "|".join(parts)

COMBINED_IGNORE = _combined_ignore()

def _out0(ctx, lbl):
    # Default output[0] of an UNMODIFIED configured target (env tools — built
    # normally, not instrumented).
    return ctx.analysis(ctx.configured_targets(lbl)).providers()[DefaultInfo].default_outputs[0]

def _emit(ctx, actions, llvm, run_one, report_sh, pkg, nodes, fixture_env, all_pkgs):
    name = pkg.replace("/", "_")
    # Sort by label name: single stable deterministic key -> reproducible object
    # order -> reproducible coverage %. See the ordering note at the top.
    bins = []
    profraws = []
    for node in sorted(nodes, key = lambda n: n.label.name):
        ct = ctx.configured_targets(node.label, modifiers = COVERAGE_MODIFIERS)
        bin = ctx.analysis(ct).providers()[DefaultInfo].default_outputs[0]
        pr = actions.declare_output("prof/{}/{}.profraw".format(name, node.label.name))
        # Every run is local with the DB env injected (see the uniform-execution
        # note at the top). The build stays RE-eligible; only the run is local.
        actions.run(
            cmd_args(["bash", run_one, pr.as_output(), bin]),
            category = "coverage_run",
            identifier = "{}:{}".format(name, node.label.name),
            local_only = True,
            env = fixture_env,
        )
        bins.append(bin)
        profraws.append(pr)

    # Per-crate report keeps ONLY this crate's own src (see filtering note).
    ignore = _ignore_for(pkg, all_pkgs)
    out_dir = actions.declare_output(name, dir = True)
    profdata = actions.declare_output("{}.profdata".format(name))
    args = cmd_args(["bash", report_sh, cmd_args(llvm), out_dir.as_output(), profdata.as_output(), ignore])
    args.add(profraws)
    args.add("--")
    args.add(bins)
    actions.run(args, category = "coverage_report", identifier = name)
    return out_dir, bins, profraws

def _cov_impl(ctx):
    bxl_actions = ctx.bxl_actions()
    actions = bxl_actions.actions

    llvm = ctx.analysis(ctx.configured_targets("toolchains//:llvm-x86_64-linux")).providers()[DefaultInfo].default_outputs[0]
    run_one = ctx.analysis(ctx.configured_targets("//tools/coverage:run-one")).providers()[DefaultInfo].default_outputs[0]
    report_sh = ctx.analysis(ctx.configured_targets("//tools/coverage:report-sh")).providers()[DefaultInfo].default_outputs[0]

    # Fixture env, built ONCE from the same source targets `loom_fixture_test`
    # uses (mirrored from src/control-plane/postgres/defs.bzl). The full
    # postgres+duckdb env is harmless on non-duckdb fixture tests.
    pg = _out0(ctx, "//src/control-plane/postgres:postgres-bin")
    xml = _out0(ctx, "//src/control-plane/postgres:libxml2")
    migr = _out0(ctx, "//src/control-plane/postgres:migrations")
    duck = _out0(ctx, "//src/control-plane/postgres:duckdb-cli")
    duckext = _out0(ctx, "//src/control-plane/postgres:duckdb-extensions")
    fixture_env = {
        "POSTGRES_BIN_DIR": cmd_args(pg, format = "{}/bin"),
        "POSTGRES_LD_LIBRARY_PATH": cmd_args(cmd_args(pg, format = "{}/lib"), xml, delimiter = ":"),
        "LOOM_MIGRATIONS_DIR": cmd_args(migr, format = "{}/migrations"),
        "DUCKDB_BIN": cmd_args(duck),
        "DUCKDB_EXTENSION_DIR": cmd_args(duckext),
        # The fixture creates its postgres unix socket under TMPDIR
        # (tempfile::tempdir -> std::env::temp_dir). buck sets TMPDIR for an
        # action to a DEEP buck-out path, which overflows the ~107-char
        # sockaddr_un limit ("could not create any Unix-domain sockets") and the
        # fixture panics before exercising any production code (only fixture.rs
        # gets partial coverage). buck2's own test runner gives these tests a
        # short TMPDIR, which is why `loom_fixture_test` doesn't need this; under
        # a BXL action we must pin a short TMPDIR ourselves.
        "TMPDIR": "/tmp",
    }

    crate = ctx.cli_args.crate
    universe = "//src/{}/...".format(crate) if crate else "//src/..."

    # FULL first-party package set (every package under //src with a rust_test),
    # independent of the --crate run scope. Used to build the per-crate ignore
    # regex so a SINGLE-crate report still excludes sibling crates' src that its
    # tests transitively link. Derived from the query — no hardcoded list.
    full_pkgs_seen = {}
    for node in ctx.uquery().kind("rust_test", ctx.uquery().eval("//src/...")):
        full_pkgs_seen[str(node.label.package)] = None
    all_pkgs = sorted(full_pkgs_seen.keys())

    tests = ctx.uquery().kind("rust_test", ctx.uquery().eval(universe))

    # Group the IN-SCOPE tests by crate package (fixtures included now).
    groups = {}
    for node in tests:
        pkg = str(node.label.package)
        groups.setdefault(pkg, []).append(node)

    # Empty scope (e.g. a typo'd --crate) — surface it clearly instead of letting
    # the combined report.sh fail on zero profraws / an unbound ${bins[0]}.
    if not groups:
        ctx.output.print("coverage: no rust_test targets under {} — nothing to do".format(universe))
        return

    all_bins = []
    all_profraws = []
    # Run/report only the in-scope packages; filter against the FULL package set
    # (all_pkgs) so per-crate reports exclude sibling src even in --crate mode.
    for pkg in sorted(groups.keys()):
        out_dir, bins, profraws = _emit(
            ctx,
            actions,
            llvm,
            run_one,
            report_sh,
            pkg,
            groups[pkg],
            fixture_env,
            all_pkgs,
        )
        ctx.output.print("CRATE {} -> {}".format(pkg, ctx.output.ensure(out_dir)))
        all_bins.extend(bins)
        all_profraws.extend(profraws)

    # One combined report across ALL bins/profraws. Bins are appended in
    # sorted-package then sorted-label order, so the combined object order is
    # deterministic too. Uses COMBINED_IGNORE (keep all 7 crates' src, drop
    # testkit) — a DIFFERENT regex than the per-crate reports.
    combined_dir = actions.declare_output("combined", dir = True)
    combined_profdata = actions.declare_output("combined.profdata")
    args = cmd_args(["bash", report_sh, cmd_args(llvm), combined_dir.as_output(), combined_profdata.as_output(), COMBINED_IGNORE])
    args.add(all_profraws)
    args.add("--")
    args.add(all_bins)
    actions.run(args, category = "coverage_report", identifier = "combined")

    ctx.output.print(ctx.output.ensure(combined_dir))

cov = bxl_main(
    impl = _cov_impl,
    cli_args = {
        "crate": cli_args.option(cli_args.string()),
    },
)
