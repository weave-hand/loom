genrule(
    name = "rust-code-analysis-x86_64-linux",
    out = "rust-code-analysis-cli",
    cmd = "mkdir -p $TMP/x && tar -xzf $(location :rca-x86_64-linux.tar.gz) -C $TMP/x --strip-components=1 && cp $TMP/x/rust-code-analysis-cli $OUT && chmod +x $OUT",
    executable = True,
)

