# prek (https://github.com/j178/prek) — a fast Rust reimplementation of
# pre-commit that manages and runs git hooks. Like reindeer, this is a dev-time
# tool, not a build-time dep of any service. To bump: replace PREK_VERSION
# below, then refresh each SHA256 from the matching `<asset>.tar.gz.sha256`
# sidecar on the release page.
#
# `buck2 run //tools:prek -- <args>` invokes the binary for the current target
# CPU. Only Linux x86_64 / aarch64 are wired — matches platforms/BUCK.

PREK_VERSION = "v0.4.3"

_PREK_URL = "https://github.com/j178/prek/releases/download/{version}/prek-{triple}.tar.gz"

http_file(
    name = "prek-x86_64-linux.tar.gz",
    urls = [_PREK_URL.format(version = PREK_VERSION, triple = "x86_64-unknown-linux-gnu")],
    sha256 = "8a8210d64476657cac3e797afa109011d8d872c09e3a407f50c5a4dde063b381",
)

http_file(
    name = "prek-aarch64-linux.tar.gz",
    urls = [_PREK_URL.format(version = PREK_VERSION, triple = "aarch64-unknown-linux-gnu")],
    sha256 = "02e5731ce90e737bade91abef4c76c13495b9cc9290f609dfcb2e7b2a05b532e",
)

# Unlike reindeer's bare `.zst`, prek ships proper `.tar.gz` archives, so these
# genrules untar with `tar`/`gzip` — both present on the BuildBuddy RE workers,
# so no host-only `uses_xz` label is needed. The binary lives at
# `prek-<triple>/prek` inside the archive; `--strip-components=1` flattens that
# wrapping directory away.

genrule(
    name = "prek-x86_64-linux",
    out = "prek",
    cmd = "mkdir -p $TMP/x && tar -xzf $(location :prek-x86_64-linux.tar.gz) -C $TMP/x --strip-components=1 && cp $TMP/x/prek $OUT && chmod +x $OUT",
    executable = True,
)

genrule(
    name = "prek-aarch64-linux",
    out = "prek",
    cmd = "mkdir -p $TMP/x && tar -xzf $(location :prek-aarch64-linux.tar.gz) -C $TMP/x --strip-components=1 && cp $TMP/x/prek $OUT && chmod +x $OUT",
    executable = True,
)

command_alias(
    name = "prek",
    exe = select({
        "prelude//cpu/constraints:x86_64": ":prek-x86_64-linux",
        "prelude//cpu/constraints:arm64": ":prek-aarch64-linux",
    }),
    visibility = ["PUBLIC"],
)

# rustfmt — the formatter from the same Rust nightly the toolchain is pinned to
# (see toolchains/BUCK). The rustfmt-preview dist ships only `bin/rustfmt`, which
# dynamically links against librustc_driver in the rustc dist's `lib/`, so the
# wrapper points LD_LIBRARY_PATH there before exec'ing it.
#
# `buck2 run //tools:rustfmt -- --check src/hello/src/main.rs`
#
# The wrapper bakes absolute `$PWD` paths to the dist outputs, so it is only
# valid on the machine that built it — the `uses_local_filesystem_abspaths`
# label (see prelude/genrule_local_labels.bzl) forces the genrule off RE so
# those paths resolve. Host-only and x86_64-only, matching the rustc dist.

genrule(
    name = "rustfmt",
    srcs = [
        "toolchains//:rustfmt-x86_64-linux",
        "toolchains//:rustc-x86_64-linux",
    ],
    out = "rustfmt",
    bash = """
        RUSTFMT_DIR="$PWD/$(location toolchains//:rustfmt-x86_64-linux)"
        RUSTC_DIR="$PWD/$(location toolchains//:rustc-x86_64-linux)"
        cat > $OUT <<WRAPPER
#!/usr/bin/env bash
export LD_LIBRARY_PATH="$RUSTC_DIR/lib"
exec "$RUSTFMT_DIR/bin/rustfmt" "\\$@"
WRAPPER
        chmod +x $OUT
    """,
    labels = ["uses_local_filesystem_abspaths"],
    executable = True,
    visibility = ["PUBLIC"],
)

# rust-analyzer — the language server from the same Rust nightly the toolchain is
# pinned to (see toolchains/BUCK), wrapping the `rust-analyzer-preview` dist. Like
# rustfmt, the binary dynamically links against librustc_driver in the rustc
# dist's `lib/`, and — importantly — when it spawns itself as a proc-macro server
# it dlopen's proc-macro `.so`s built against this toolchain's libstd, which also
# lives in `lib/`; so the wrapper points LD_LIBRARY_PATH there before exec'ing it.
# Exposed on PATH via tools/env.sh so it shadows any `~/.cargo/bin/rust-analyzer`
# rustup shim. Consumed by the rust-analyzer-lsp integration.
#
# The wrapper bakes absolute `$PWD` paths to the dist outputs, so the
# `uses_local_filesystem_abspaths` label forces the genrule off RE so those paths
# resolve. Host-only and x86_64-only, matching the rustc dist.
genrule(
    name = "rust-analyzer",
    srcs = [
        "toolchains//:rust-analyzer-x86_64-linux",
        "toolchains//:rustc-x86_64-linux",
    ],
    out = "rust-analyzer",
    bash = """
        RA_DIR="$PWD/$(location toolchains//:rust-analyzer-x86_64-linux)"
        RUSTC_DIR="$PWD/$(location toolchains//:rustc-x86_64-linux)"
        cat > $OUT <<WRAPPER
#!/usr/bin/env bash
export LD_LIBRARY_PATH="$RUSTC_DIR/lib\\${LD_LIBRARY_PATH:+:\\$LD_LIBRARY_PATH}"
exec "$RA_DIR/bin/rust-analyzer" "\\$@"
WRAPPER
        chmod +x $OUT
    """,
    labels = ["uses_local_filesystem_abspaths"],
    executable = True,
    visibility = ["PUBLIC"],
)

# clippy — two flavors of clippy are available:
#
#   1. The buck2-native lint, already wired via `clippy_driver` in the rust
#      toolchain (toolchains/BUCK). Run it as a sub-target on any Rust rule:
#          buck2 build '//src/hello:hello[clippy.txt]'   # diagnostics, text
#          buck2 build '//src/hello:hello[clippy.json]'  # diagnostics, json
#      To lint all first-party Rust at once, use tools/clippy-all.sh (buck2 has
#      no `//...[clippy.txt]` syntax).
#
#   2. `buck2 run //tools:clippy` — a standalone `cargo clippy` for the ad-hoc
#      Cargo workflow (and prek hooks), built below.
#
# `:rust-host-toolchain` — a complete, runnable host Rust toolchain assembled
# from the dists in toolchains/BUCK. Used by `:clippy` below, by tools/buckify.sh
# (reindeer shells out to `cargo metadata`), and by `rust-project develop` as the
# sysroot it hands rust-analyzer — so none of them need a host rustup. The rustc
# dist ships no host std (it lives in the separate
# rust-std dist), so we assemble a sysroot: rustc at `<root>/bin/rustc` with std
# merged under `<root>/lib/rustlib/<triple>/lib`, so rustc's default sysroot
# detection (two dirs up from the binary) finds std. cargo, cargo-clippy,
# clippy-driver, and rustdoc sit alongside in `bin/`. Pinned to the same nightly
# as the toolchain. x86_64 host only, matching the rustc dist.

RUST_HOST_TRIPLE = "x86_64-unknown-linux-gnu"

genrule(
    name = "rust-host-toolchain",
    srcs = [
        "toolchains//:rustc-x86_64-linux",
        "toolchains//:rust-std-x86_64-linux",
        "toolchains//:cargo-x86_64-linux",
        "toolchains//:clippy-x86_64-linux",
    ],
    out = "toolchain",
    bash = """
        set -euo pipefail
        RUSTC_DIST="$(location toolchains//:rustc-x86_64-linux)"
        STD_DIST="$(location toolchains//:rust-std-x86_64-linux)"
        CARGO_DIST="$(location toolchains//:cargo-x86_64-linux)"
        CLIPPY_DIST="$(location toolchains//:clippy-x86_64-linux)"
        TRIPLE="{triple}"

        mkdir -p "$OUT/bin" "$OUT/lib/rustlib/$TRIPLE/lib"
        # rustc's own shared libs (librustc_driver, codegen backends, rust-lld).
        cp -rfL "$RUSTC_DIST"/lib/. "$OUT/lib/"
        # std rlibs/rmeta for the host triple, merged into the sysroot.
        cp -rfL "$STD_DIST/lib/rustlib/$TRIPLE/lib/." "$OUT/lib/rustlib/$TRIPLE/lib/"
        cp -L "$RUSTC_DIST/bin/rustc" "$OUT/bin/rustc"
        cp -L "$RUSTC_DIST/bin/rustdoc" "$OUT/bin/rustdoc"
        cp -L "$CARGO_DIST/bin/cargo" "$OUT/bin/cargo"
        cp -L "$CLIPPY_DIST/bin/cargo-clippy" "$OUT/bin/cargo-clippy"
        cp -L "$CLIPPY_DIST/bin/clippy-driver" "$OUT/bin/clippy-driver"
        # rust-analyzer's proc-macro server. `rust-project develop` points
        # rust-analyzer at this assembled toolchain as its sysroot, and
        # rust-analyzer derives the server as <sysroot>/libexec/rust-analyzer-proc-macro-srv.
        # Without it, attribute/derive proc-macros never expand and the editor
        # shows thousands of false diagnostics. The binary's rpath ($ORIGIN/../lib)
        # resolves librustc_driver/libLLVM out of $OUT/lib above, so no wrapper.
        mkdir -p "$OUT/libexec"
        cp -L "$RUSTC_DIST/libexec/rust-analyzer-proc-macro-srv" "$OUT/libexec/rust-analyzer-proc-macro-srv"
    """.format(triple = RUST_HOST_TRIPLE),
    visibility = ["PUBLIC"],
)

# Wrapper that puts the assembled toolchain's bin/ on PATH (so cargo-clippy
# finds cargo, rustc, and clippy-driver) and points LD_LIBRARY_PATH at its libs.
# Bakes an absolute path to the assembled dir, hence the local-only label.
genrule(
    name = "clippy",
    srcs = [":rust-host-toolchain"],
    out = "clippy",
    bash = """
        ROOT="$PWD/$(location :rust-host-toolchain)"
        cat > $OUT <<WRAPPER
#!/usr/bin/env bash
export PATH="$ROOT/bin:\\$PATH"
export LD_LIBRARY_PATH="$ROOT/lib"
exec "$ROOT/bin/cargo-clippy" "\\$@"
WRAPPER
        chmod +x $OUT
    """,
    labels = ["uses_local_filesystem_abspaths"],
    executable = True,
    visibility = ["PUBLIC"],
)

# Contract test: the assembled :rust-host-toolchain is the sysroot that
# `rust-project develop` hands rust-analyzer, and rust-analyzer derives the
# proc-macro server from <sysroot>/libexec/. Assert that server is present and
# runnable so a change to the genrule above can't silently drop it (which would
# flood the editor with false diagnostics — proc-macros never expand). Declaring
# :rust-host-toolchain as a $(location ...) makes the assembled dir a buck input,
# so this re-runs only when the toolchain changes.
rust_test(
    name = "rust-analyzer-proc-macro-srv-present",
    srcs = ["tests/proc_macro_srv_present.rs"],
    crate = "proc_macro_srv_present",
    crate_root = "tests/proc_macro_srv_present.rs",
    env = {"LOOM_RUST_HOST_TOOLCHAIN": "$(location :rust-host-toolchain)"},
)

# btd / supertd — Buck Target Determinator (https://github.com/facebookincubator/buck2-change-detector).
# Upstream ships no prebuilt binaries, so we consume them from a fork that adds a
# release workflow: rsJames-ttrpg/buck2-change-detector. Each release tarball
# holds BOTH binaries (`btd` and `supertd`) at its top level. Used to map a set
# of changed files to the affected buck2 targets, so hooks/CI build & test only
# what a diff impacts instead of everything.
#
# `buck2 run //tools:supertd -- targets root//... --output base.jsonl`
# `buck2 run //tools:btd -- --changes changes.txt --base base.jsonl --universe root//...`
#
# To bump: rebuild the fork's release (tag a new vX.Y.Z), then update BTD_VERSION
# and refresh each sha256 from the matching `<asset>.tar.gz.sha256` sidecar.

BTD_VERSION = "v0.1.0"

_BTD_URL = "https://github.com/rsJames-ttrpg/buck2-change-detector/releases/download/{version}/btd-{triple}.tar.gz"

http_file(
    name = "btd-x86_64-linux.tar.gz",
    urls = [_BTD_URL.format(version = BTD_VERSION, triple = "x86_64-unknown-linux-gnu")],
    sha256 = "690cc648a34d3b3a8daa31ec2689fff8bb04dbbded9492328529896e4a34a2a6",
)

http_file(
    name = "btd-aarch64-linux.tar.gz",
    urls = [_BTD_URL.format(version = BTD_VERSION, triple = "aarch64-unknown-linux-gnu")],
    sha256 = "886ab59e280ccc1137e98d0990247449134ee8dc44f41674d2cb062cbc5d86dd",
)

# One genrule per (binary, arch): untar (no wrapping dir — binaries are at the
# archive root) and pull out the requested binary. tar/gzip are on RE, so no
# local-only label needed.
[
    genrule(
        name = "{}-bin-{}".format(binary, arch),
        out = binary,
        cmd = "mkdir -p $TMP/x && tar -xzf $(location :btd-{}-linux.tar.gz) -C $TMP/x && cp $TMP/x/{} $OUT && chmod +x $OUT".format(arch, binary),
        executable = True,
    )
    for binary in ["btd", "supertd"]
    for arch in ["x86_64", "aarch64"]
]

command_alias(
    name = "btd",
    exe = select({
        "prelude//cpu/constraints:x86_64": ":btd-bin-x86_64",
        "prelude//cpu/constraints:arm64": ":btd-bin-aarch64",
    }),
    visibility = ["PUBLIC"],
)

command_alias(
    name = "supertd",
    exe = select({
        "prelude//cpu/constraints:x86_64": ":supertd-bin-x86_64",
        "prelude//cpu/constraints:arm64": ":supertd-bin-aarch64",
    }),
    visibility = ["PUBLIC"],
)

# jq (https://github.com/jqlang/jq) — vendored so the code-health routines render
# deterministically without depending on a host `jq` (loom-stpa uses host jq; that
# is a reproducibility hole for a scheduled routine). The Linux release assets are
# RAW STATIC BINARIES (not archives), so the genrule is just cp + chmod — no
# host-only label needed (cp/chmod are on every RE worker, like the prek block).
# To bump: replace JQ_VERSION and refresh each SHA256 from the `<asset>.sha256` on
# the release page (or `sha256sum` the downloaded asset).
#
# Two naming quirks vs the other blocks: (1) jq's git tags are `jq-X.Y.Z`, not
# `vX.Y.Z`, so JQ_VERSION carries the `jq-` prefix and feeds straight into the URL;
# (2) jq's release assets use `amd64`/`arm64` in their filenames (not Rust triples),
# so the `http_file` names mirror that while the genrules keep the repo's
# `x86_64`/`aarch64` convention.
#
# `buck2 run //tools:jq -- <args>`. Linux x86_64 / aarch64 only (matches platforms/BUCK).

