load(":wasm_bindgen.bzl", "WASM_BINDGEN_VERSION")

# zstd (https://github.com/aspect-build/zstd-prebuilt) — statically-linked `zstd`
# CLI, vendored so the `.zst` decompress genrules below (reindeer, rust-project)
# run on RE instead of being pinned local. The aspect-build release ships RAW
# STATIC BINARIES (not archives), so the genrule is just cp + chmod (no host-only
# label, like jq). Consumers reference it via `$(exe root//tools:zstd)`, which
# materializes the binary on whatever platform the action runs on — so NO host
# `zstd` is needed anywhere (local or RE), closing the gap the old `uses_xz`
# label papered over. To bump: replace ZSTD_VERSION and refresh each sha256 from
# the release's SHA256.txt. Linux x86_64 / aarch64 only (matches platforms/BUCK);
# asset names use `amd64`/`arm64`, the genrules keep the repo's `x86_64`/`aarch64`.

ZSTD_VERSION = "v1.5.6-bcr2"

_ZSTD_URL = "https://github.com/aspect-build/zstd-prebuilt/releases/download/{version}/zstd_linux_{arch}"

http_file(
    name = "zstd-amd64.bin",
    urls = [_ZSTD_URL.format(version = ZSTD_VERSION, arch = "amd64")],
    sha256 = "190c196b46883a234238d9c52a211c1494df79bb170fbe30c6fc22639d5d4731",
)

http_file(
    name = "zstd-arm64.bin",
    urls = [_ZSTD_URL.format(version = ZSTD_VERSION, arch = "arm64")],
    sha256 = "4fa2386a975c2120f91f3103bd4268a19a341cb9063417f3829018e94f28c8c6",
)

genrule(
    name = "zstd-x86_64-linux",
    out = "zstd",
    cmd = "cp $(location :zstd-amd64.bin) $OUT && chmod +x $OUT",
    executable = True,
)

genrule(
    name = "zstd-aarch64-linux",
    out = "zstd",
    cmd = "cp $(location :zstd-arm64.bin) $OUT && chmod +x $OUT",
    executable = True,
)

command_alias(
    name = "zstd",
    exe = select({
        "prelude//cpu/constraints:x86_64": ":zstd-x86_64-linux",
        "prelude//cpu/constraints:arm64": ":zstd-aarch64-linux",
    }),
    visibility = ["PUBLIC"],
)

# Reindeer (third-party Rust dependency importer). Used at dev time to materialize
# BUCK targets for crates declared in third-party manifests; not a build-time dep
# of any service.
#
# loom consumes the **weave-hand/reindeer** fork, which carries the "honor
# dependency renames from all workspace members" fix (PR #1) that upstream lacks:
# it lets a virtual workspace disambiguate two public majors of one crate via a
# Cargo dep rename, so `tools/buckify.sh` needs no alias post-processing. The fork
# ships the same per-arch `.zst` release assets as upstream.
#
# We pull the prebuilt release binary instead of building from source. To bump:
# replace REINDEER_VERSION below, then update each SHA256 from the matching
# `.zst` asset on the release page. Decompression uses the vendored
# `//tools:zstd` (above) via `$(exe …)`, so these genrules run on RE and need no
# host `zstd`.
#
# `buck2 run //tools:reindeer -- <args>` invokes the binary for the current
# target CPU. Only Linux x86_64 / aarch64 are wired — matches platforms/BUCK.

REINDEER_VERSION = "v2026.07.17.00"

_REINDEER_URL = "https://github.com/weave-hand/reindeer/releases/download/{version}/reindeer-{triple}.zst"

http_file(
    name = "reindeer-x86_64-linux.zst",
    urls = [_REINDEER_URL.format(version = REINDEER_VERSION, triple = "x86_64-unknown-linux-gnu")],
    sha256 = "2b58af20425e40d79eb22e8761a754789d65644d2e7f7ff478e3e0dd75dbbdc4",
)

http_file(
    name = "reindeer-aarch64-linux.zst",
    urls = [_REINDEER_URL.format(version = REINDEER_VERSION, triple = "aarch64-unknown-linux-gnu")],
    sha256 = "9ee50586a3ad9d5cba41f3d22d3fa3303f8aba01d9b7f499acfe16eeec1afc13",
)

genrule(
    name = "reindeer-x86_64-linux",
    out = "reindeer",
    cmd = "$(exe root//tools:zstd) -d -c $(location :reindeer-x86_64-linux.zst) > $OUT && chmod +x $OUT",
    executable = True,
)

genrule(
    name = "reindeer-aarch64-linux",
    out = "reindeer",
    cmd = "$(exe root//tools:zstd) -d -c $(location :reindeer-aarch64-linux.zst) > $OUT && chmod +x $OUT",
    executable = True,
)

command_alias(
    name = "reindeer",
    exe = select({
        "prelude//cpu/constraints:x86_64": ":reindeer-x86_64-linux",
        "prelude//cpu/constraints:arm64": ":reindeer-aarch64-linux",
    }),
    visibility = ["PUBLIC"],
)

# rust-project — buck2's rust-analyzer integration (the `rust-project develop`
# tool that generates the `rust-project.json` RA consumes). Upstream
# facebook/buck2 ships it only as a source crate (integrations/rust-project,
# `cargo install`-only, see DEVELOPING.md), so loom consumes a prebuilt from the
# **weave-hand/buck2** fork, which adds a release workflow. Vendoring it makes the
# IDE/cloud RA path hermetic (no host `cargo install`) — exposed on PATH via
# tools/env.sh and used by tools/cloud-session-start.sh to regenerate
# rust-project.json per cloud session.
#
# Like reindeer, the release assets are bare per-arch `.zst` binaries (not
# tarballs), so the decompress genrules use the vendored `//tools:zstd` via
# `$(exe …)` — they run on RE and need no host `zstd`. The fork's tag is
# `rust-project/<version>` (a path-style tag), which GitHub serves at a
# literal-slash download URL.
#
# To bump: cut a new release on the fork (track the buck2 release loom is pinned
# to, BUCK2_RELEASE), then update RUST_PROJECT_VERSION and refresh each sha256
# (e.g. `sha256sum` the downloaded `.zst`). Linux x86_64 / aarch64 only.

