{
  "enabledMcpjsonServers": ["buildbuddy"],
  "permissions": {
    "allow": [
      "mcp__buildbuddy",
      "mcp__buildbuddy__get_invocation",
      "mcp__buildbuddy__get_target",
      "mcp__buildbuddy__get_action",
      "mcp__buildbuddy__get_log",
      "mcp__buildbuddy__get_file_range"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/cloud-session-start.sh\""
          }
        ]
      },
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/superpowers-session-start.sh\""
          }
        ]
      }
    ]
  }
}
