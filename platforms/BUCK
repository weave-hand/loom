load(":defs.bzl", "loom_execution_platforms")

# Registered execution platforms (see .buckconfig [build] execution_platforms).
# Both arches are registered so a single build can place actions on amd64 or
# arm64 workers; the rust toolchain's exec_compatible_with is what steers an
# arm64-configured compile onto the arm64 platform (else amd64 wins as the first
# compatible entry). Target platforms still default from the prelude detector
# (see .buckconfig target_platform_detector_spec) — this only wires *execution*.
loom_execution_platforms(
    name = "default",
    amd64 = ":linux-x86_64",
    arm64 = ":linux-aarch64",
    visibility = ["PUBLIC"],
)

platform(
    name = "linux-x86_64",
    constraint_values = [
        "prelude//cpu/constraints:x86_64",
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "linux-aarch64",
    constraint_values = [
        "prelude//cpu/constraints:arm64",
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

# wasm cross-compile platform for //src/ui. Carries the host os/cpu (so exec-side
# deps like proc-macros still resolve to the host toolchain) PLUS the wasm32
# constraint that flips the rust toolchain's target triple + std dist.
platform(
    name = "wasm",
    constraint_values = [
        "prelude//cpu/constraints:x86_64",
        "prelude//os/constraints:linux",
        "root//platforms/constraints:wasm32",
    ],
    visibility = ["PUBLIC"],
)
