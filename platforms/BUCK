load("@prelude//platforms:defs.bzl", "host_configuration")
load(":defs.bzl", "buildbuddy_platforms")

buildbuddy_platforms(
    name = "default",
    cpu_configuration = host_configuration.cpu,
    os_configuration = host_configuration.os,
    visibility = ["PUBLIC"],
)

platform(
    name = "linux-x86_64",
    constraint_values = [
        "prelude//cpu/constraints:x86_64",
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "linux-aarch64",
    constraint_values = [
        "prelude//cpu/constraints:arm64",
        "prelude//os/constraints:linux",
    ],
    visibility = ["PUBLIC"],
)

# wasm cross-compile platform for //src/ui. Carries the host os/cpu (so exec-side
# deps like proc-macros still resolve to the host toolchain) PLUS the wasm32
# constraint that flips the rust toolchain's target triple + std dist.
platform(
    name = "wasm",
    constraint_values = [
        "prelude//cpu/constraints:x86_64",
        "prelude//os/constraints:linux",
        "root//platforms/constraints:wasm32",
    ],
    visibility = ["PUBLIC"],
)
