# rust-analyzer — the language server from the same pinned nightly, consumed by
# the rust-analyzer-lsp editor/agent integration (see DEVELOPING.md's
# `rust-project develop` flow). Ships as the `rust-analyzer-preview` component
# (same -preview convention as clippy/rustfmt). Wrapped by //tools:rust-analyzer
# and put on PATH via tools/env.sh so the hermetic binary shadows any
# rustup-managed `~/.cargo/bin/rust-analyzer` shim. Host-only / x86_64-only,
# matching the rustc dist.
http_archive(
    name = "rust-analyzer-x86_64-linux",
    urls = ["https://static.rust-lang.org/dist/{}/rust-analyzer-nightly-{}.tar.xz".format(RUST_NIGHTLY, RUST_HOST)],
    sha256 = "2348e71a1a7c7c31e025b0ead4aa036d18f376f2ab5ba016e4fdab93f1bfc097",
    strip_prefix = "rust-analyzer-nightly-{}/rust-analyzer-preview".format(RUST_HOST),
    visibility = ["PUBLIC"],
)

