# loom engine service image: multi-arch (linux/amd64 + linux/arm64). The apko base
# is built per-arch and the buck2-built `engine-bin` is staged per-arch, then combined
# into one OCI index (see //images:multiarch.bzl). Kept under //deploy (not //src) so
# it stays off the normal CI build sweep — apko fetches packages over the network and
# builds local-only; the release workflow builds/pushes it explicitly. The engine runs
# as a sidecar in the query-api pod, serving its Arrow Flight + control plane over the
# shared LOOM_ENGINE_SOCKET unix-domain socket.
load("//images:multiarch.bzl", "multiarch_oci_image")

# Deployable multi-arch image + `.info` (digest pin) + `.push` (crane push to ghcr).
# Base (glibc + libgcc + CA certs, nonroot, entrypoint = /usr/local/bin/engine) from
# apko.yaml; the engine binary is staged at that entrypoint path per arch.
multiarch_oci_image(
    name = "image",
    config = "apko.yaml",
    lock = "apko.lock.json",
    binary = "root//src/services/engine:engine-bin",
    path = "/usr/local/bin/engine",
    repository = "ghcr.io/weave-hand/loom-engine",
)
