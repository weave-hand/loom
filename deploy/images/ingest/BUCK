# loom ingest service image: the buck2-built `ingest-bin` (x86_64 glibc) layered
# onto an apko/Wolfi base. Kept under //deploy (not //src) so it stays off the
# normal CI build sweep — apko fetches packages over the network and builds
# local-only; the release workflow builds/pushes it explicitly.
load("//buck2/apko:defs.bzl", "apko_image")
load("//buck2/oci:defs.bzl", "oci_image", "tar_layer")

# Wolfi base (glibc + libgcc + CA certs, nonroot, entrypoint = /usr/local/bin/ingest).
apko_image(
    name = "base",
    config = "apko.yaml",
    lock = "apko.lock.json",
)

# Stage the ingest binary at the base's entrypoint path.
tar_layer(
    name = "bin_layer",
    binary = "//src/services/ingest:ingest-bin",
    path = "/usr/local/bin/ingest",
)

# Deployable image + `.info` (digest pin) + `.push` (crane push to ghcr).
oci_image(
    name = "image",
    base = ":base",
    layers = [":bin_layer"],
    repository = "ghcr.io/weave-hand/loom-ingest",
)
