# loom ingest service image: multi-arch (linux/amd64 + linux/arm64). The apko base
# is built per-arch and the buck2-built `ingest-bin` is staged per-arch, then the
# two are combined into one OCI index (see //images:multiarch.bzl). Kept under
# //deploy (not //src) so it stays off the normal CI build sweep — apko fetches
# packages over the network and builds local-only; the release workflow builds/pushes
# it explicitly.
load("//images:multiarch.bzl", "multiarch_oci_image")

# Deployable multi-arch image + `.info` (digest pin) + `.push` (crane push to ghcr).
# The apko base (glibc + libgcc + CA certs, nonroot, entrypoint = /usr/local/bin/ingest)
# comes from apko.yaml; the ingest binary is staged at that entrypoint path per arch.
multiarch_oci_image(
    name = "image",
    config = "apko.yaml",
    lock = "apko.lock.json",
    binary = "root//src/services/ingest:ingest-bin",
    path = "/usr/local/bin/ingest",
    repository = "ghcr.io/weave-hand/loom-ingest",
)
