# loom query-api service image: the buck2-built `query-api-bin` (x86_64 glibc)
# layered onto an apko/Wolfi base. query-api is now a pure wire client with no
# embedded analytics engine — it reads over the engine's Arrow Flight service via a shared
# unix-domain socket (LOOM_ENGINE_SOCKET), with the engine running as a sidecar
# in the same pod (see deploy/chart/chart/templates/query-api.yaml). The binary
# is therefore a plain glibc Rust binary with the same package set as ingest.
# Kept under //deploy (not //src) so it stays off the normal CI build sweep — the
# release workflow builds/pushes it explicitly.
load("@homelab//buck2/apko:defs.bzl", "apko_image")
load("@homelab//buck2/oci:defs.bzl", "oci_image", "tar_layer")

# Wolfi base (glibc + libgcc + CA certs, nonroot,
# entrypoint = /usr/local/bin/query-api).
apko_image(
    name = "base",
    config = "apko.yaml",
    lock = "apko.lock.json",
)

# Stage the query-api binary at the base's entrypoint path.
tar_layer(
    name = "bin_layer",
    binary = "root//src/services/query-api:query-api-bin",
    path = "/usr/local/bin/query-api",
)

# The wasm UI bundle, pinned to the wasm target platform. A plain dep from this
# (linux-configured) cell would re-configure //src/ui:bundle for linux and break
# the yew cross-compile — `default_target_platform` does not survive being a
# dependency, so the platform must be forced here.
configured_alias(
    name = "ui-bundle",
    actual = "root//src/ui:bundle",
    platform = "root//platforms:wasm",
)

# Stage the UI dist dir (index.html, config.js, app.js, app_bg.wasm) at the
# path the chart points LOOM_UI_DIR at. `tar_layer` stages single executables,
# so this stays a local genrule over the dist directory.
genrule(
    name = "ui_layer",
    out = "layer.tar",
    cmd = " && ".join([
        "mkdir -p \"$TMP/root/usr/share/loom/ui\"",
        "cp -r $(location :ui-bundle)/. \"$TMP/root/usr/share/loom/ui/\"",
        "tar -C \"$TMP/root\" -cf $OUT .",
    ]),
)

# Deployable image + `.info` (digest pin) + `.push` (crane push to ghcr).
oci_image(
    name = "image",
    base = ":base",
    layers = [
        ":bin_layer",
        ":ui_layer",
    ],
    repository = "ghcr.io/weave-hand/loom-query-api",
)
