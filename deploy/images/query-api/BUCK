# loom query-api service image: multi-arch (linux/amd64 + linux/arm64). query-api is a
# pure wire client with no embedded analytics engine — it reads over the engine's Arrow
# Flight service via a shared unix-domain socket (LOOM_ENGINE_SOCKET), with the engine
# running as a sidecar in the same pod (see deploy/chart/chart/templates/query-api.yaml).
# The apko base is built per-arch and the buck2-built `query-api-bin` is staged per-arch;
# the arch-agnostic wasm UI bundle is added to both arches; the two are combined into one
# OCI index (see //images:multiarch.bzl). Kept under //deploy (not //src) so it stays off
# the normal CI build sweep — the release workflow builds/pushes it explicitly.
load("//images:multiarch.bzl", "multiarch_oci_image")

# The wasm UI bundle, pinned to the wasm target platform. A plain dep from this
# (linux-configured) cell would re-configure //src/ui:bundle for linux and break the
# yew cross-compile — `default_target_platform` does not survive being a dependency, so
# the platform must be forced here. The wasm output is arch-independent, so one bundle
# serves both image arches.
configured_alias(
    name = "ui-bundle",
    actual = "root//src/ui:bundle",
    platform = "root//platforms:wasm",
)

# Stage the UI dist dir (index.html, config.js, app.js, app_bg.wasm) at the path the
# chart points LOOM_UI_DIR at. Arch-agnostic — added to every image arch.
genrule(
    name = "ui_layer",
    out = "layer.tar",
    cmd = " && ".join([
        "mkdir -p \"$TMP/root/usr/share/loom/ui\"",
        "cp -r $(location :ui-bundle)/. \"$TMP/root/usr/share/loom/ui/\"",
        "tar -C \"$TMP/root\" -cf $OUT .",
    ]),
)

# Deployable multi-arch image + `.info` (digest pin) + `.push` (crane push to ghcr).
# Base (glibc + libgcc + CA certs, nonroot, entrypoint = /usr/local/bin/query-api) from
# apko.yaml; the query-api binary is staged at that entrypoint path per arch, plus the
# shared wasm UI layer.
multiarch_oci_image(
    name = "image",
    config = "apko.yaml",
    lock = "apko.lock.json",
    binary = "root//src/services/query-api:query-api-bin",
    path = "/usr/local/bin/query-api",
    layers = [":ui_layer"],
    repository = "ghcr.io/weave-hand/loom-query-api",
)
