# loom worker service image: multi-arch (linux/amd64 + linux/arm64). The apko base
# is built per-arch and the buck2-built `worker-bin` is staged per-arch, then combined
# into one OCI index (see //images:multiarch.bzl). Kept under //deploy (not //src) so
# it stays off the normal CI build sweep — apko fetches packages over the network and
# builds local-only; the release workflow builds/pushes it explicitly. The worker runs
# as its own Deployment alongside an engine sidecar, draining queue jobs over the shared
# LOOM_ENGINE_SOCKET unix-domain socket. Without this image nothing drains the queue in
# a chart install.
load("//images:multiarch.bzl", "multiarch_oci_image")

# Deployable multi-arch image + `.info` (digest pin) + `.push` (crane push to ghcr).
# Base (glibc + libgcc + CA certs, nonroot, entrypoint = /usr/local/bin/worker) from
# apko.yaml; the worker binary is staged at that entrypoint path per arch.
multiarch_oci_image(
    name = "image",
    config = "apko.yaml",
    lock = "apko.lock.json",
    binary = "root//src/services/worker:worker-bin",
    path = "/usr/local/bin/worker",
    repository = "ghcr.io/weave-hand/loom-worker",
)
