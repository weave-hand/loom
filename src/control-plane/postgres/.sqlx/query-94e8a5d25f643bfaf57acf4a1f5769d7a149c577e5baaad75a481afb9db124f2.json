  "query": "update queue.jobs set state='running', locked_at=now(), locked_by=$1, attempts=attempts+1, updated_at=now() where id = ( select id from queue.jobs where kind = any($2) and run_at <= now() and (state='available' or (state='running' and locked_at < $3)) order by priority desc, run_at asc for update skip locked limit 1) returning id, kind, payload, attempts, run_at",
