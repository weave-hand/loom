  "query": "select sn.snapshot_id as \"snapshot_id!\", sn.snapshot_time as \"snapshot_time!\", sn.schema_version as \"schema_version!\" from iceberg_mirror.snapshot sn where sn.snapshot_id = $3 and exists ( select 1 from iceberg_mirror.table t where t.table_namespace = $1 and t.table_name = $2 and t.begin_snapshot <= sn.snapshot_id and (t.end_snapshot is null or t.end_snapshot > sn.snapshot_id))",
