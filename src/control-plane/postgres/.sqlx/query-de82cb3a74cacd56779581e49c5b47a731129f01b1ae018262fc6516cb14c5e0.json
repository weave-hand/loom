  "db_name": "PostgreSQL",
  "query": "select r.run_id as \"run_id!\", r.max_eid as \"max_eid!\", e.event_type as \"event_type!\", e.event_time as \"event_time!\", r.has_output as \"has_output!\" from ( select ev.run_id, max(ed.event_id) as max_eid, bool_or(ed.direction = 'output') as has_output from lineage.event_dataset ed join lineage.event ev on ev.event_id = ed.event_id where ed.namespace = $1 and ed.name = $2 group by ev.run_id) r join lineage.event e on e.event_id = r.max_eid where ($3::bigint is null or r.max_eid < $3) order by r.max_eid desc limit $4",
