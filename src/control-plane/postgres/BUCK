load(":defs.bzl", "loom_fixture_test")

# Prebuilt, self-contained PostgreSQL server from theseus-rs/postgresql-binaries.
# Used by the hermetic test fixture (PgFixture), which boots an ephemeral cluster
# per test — no Docker, no external DB. The binary is a buck2 build input, so the
# pg-backed contract tests stay hermetic. To bump: change PG_VERSION and refresh
# each sha256 from the matching `<asset>.tar.gz.sha256` sidecar on the release.
PG_VERSION = "17.9.0"

_PG_URL = "https://github.com/theseus-rs/postgresql-binaries/releases/download/{ver}/postgresql-{ver}-{triple}.tar.gz"

http_archive(
    name = "postgres-bin",
    urls = select({
        "ovr_config//os:linux": [_PG_URL.format(ver = PG_VERSION, triple = "x86_64-unknown-linux-gnu")],
        "ovr_config//os:macos": [_PG_URL.format(ver = PG_VERSION, triple = "aarch64-apple-darwin")],
    }),
    sha256 = select({
        "ovr_config//os:linux": "463422cb007fd15bb37819b1d3562392dd81bba385205fbd0eef4891cb1d18b5",
        "ovr_config//os:macos": "69ae8a046b34b201b6a9a22e2e6f45094dede17ddd1d3e91045bbd6ef3f36815",
    }),
    strip_prefix = select({
        "ovr_config//os:linux": "postgresql-{}-x86_64-unknown-linux-gnu".format(PG_VERSION),
        "ovr_config//os:macos": "postgresql-{}-aarch64-apple-darwin".format(PG_VERSION),
    }),
    visibility = ["PUBLIC"],
)

# The theseus-rs postgres binary dynamically links libxml2.so.2, which it does
# NOT bundle. We supply it hermetically rather than rely on a system copy: rolling
# distros (Arch) have bumped libxml2's soname (.so.16), so .so.2 is simply absent
# there, and a distro libxml2.so.2 generally hard-links a version-specific ICU
# (libicuuc.so.NN) that differs across machines. CentOS 7's libxml2 is built
# WITHOUT ICU, so its only deps are libz/liblzma/libm/libc (baseline everywhere) —
# making it a portable drop-in. We fetch the el7 RPM and extract just the .so.
http_file(
    name = "libxml2-el7.rpm",
    urls = ["https://vault.centos.org/7.9.2009/updates/x86_64/Packages/libxml2-2.9.1-6.el7_9.6.x86_64.rpm"],
    sha256 = "ffdb0e908ca8cc9013d59da38b6a5d9d04ea15e6af25a38508bc92e04af68500",
)

# Extract libxml2.so.2 from the RPM with bsdtar (libarchive reads rpm/cpio). RPM
# isn't a format http_archive understands and bsdtar isn't on the RE workers, so
# this runs locally — the `uses_xz` label (borrowed, as reindeer does for zstd)
# forces it off RE. Hosts/CI building the pg tests need `bsdtar` (libarchive).
genrule(
    name = "libxml2",
    out = "lib",
    cmd = "mkdir -p $TMP/x $OUT && bsdtar -xf $(location :libxml2-el7.rpm) -C $TMP/x ./usr/lib64/libxml2.so.2.9.1 && cp $TMP/x/usr/lib64/libxml2.so.2.9.1 $OUT/libxml2.so.2",
    labels = ["uses_xz"],
    visibility = ["PUBLIC"],
)

# Pinned DuckDB CLI + the ducklake/postgres_scanner extensions, used ONLY by the
# catalog test fixture's DuckLakeWriter to produce a real ducklake.* catalog.
# Production code never touches DuckDB. linux-x86_64 only (tests run local-only).
DUCKDB_VERSION = "v1.5.3"

http_file(
    name = "duckdb-cli.gz",
    urls = ["https://github.com/duckdb/duckdb/releases/download/{}/duckdb_cli-linux-amd64.gz".format(DUCKDB_VERSION)],
    sha256 = "f05f3b448a9a1bc6e7ac27ff14dfe67bf5761b153c2002723365a456618ef35b",
)

# Gunzip + chmod the single-file CLI. `uses_xz` forces local (off RE).
genrule(
    name = "duckdb-cli",
    out = "duckdb",
    cmd = "gzip -dc $(location :duckdb-cli.gz) > $OUT && chmod +x $OUT",
    labels = ["uses_xz"],
    visibility = ["PUBLIC"],
)

# Pinned MinIO server binary (raw static ELF, per-arch). Used by the round-trip
# test (Task 9) to boot a real S3-compatible object store. The binary is published
# as a plain file (no archive), so the genrule is a bare cp+chmod — same pattern
# as jq in tools/BUCK. To bump: update MINIO_RELEASE and refresh both sha256s from
# the matching archive URLs at dl.min.io.
MINIO_RELEASE = "RELEASE.2025-04-22T22-12-26Z"

_MINIO_URL = "https://dl.min.io/server/minio/release/linux-{arch}/archive/minio.{rel}"

http_file(
    name = "minio-amd64.bin",
    urls = [_MINIO_URL.format(arch = "amd64", rel = MINIO_RELEASE)],
    sha256 = "53e2a2cb16c5366ea6fbbc479c19ddb4c6a0948273e752f740fb1fbf27bb817c",
)

http_file(
    name = "minio-arm64.bin",
    urls = [_MINIO_URL.format(arch = "arm64", rel = MINIO_RELEASE)],
    sha256 = "6c2f3142c94240206123177f4ba1e360daa5d1e0a4962e90757ef4f92c3ab57c",
)

genrule(
    name = "minio-x86_64-linux",
    out = "minio",
    cmd = "cp $(location :minio-amd64.bin) $OUT && chmod +x $OUT",
    executable = True,
)

genrule(
    name = "minio-aarch64-linux",
    out = "minio",
    cmd = "cp $(location :minio-arm64.bin) $OUT && chmod +x $OUT",
    executable = True,
)

command_alias(
    name = "minio-bin",
    exe = select({
        "prelude//cpu/constraints:x86_64": ":minio-x86_64-linux",
        "prelude//cpu/constraints:arm64": ":minio-aarch64-linux",
    }),
    visibility = ["PUBLIC"],
)

http_file(
    name = "ducklake-ext.gz",
    urls = ["http://extensions.duckdb.org/{}/linux_amd64/ducklake.duckdb_extension.gz".format(DUCKDB_VERSION)],
    sha256 = "5fe971257a8aca6de035c49b29559982625b3d681b14777e1f2e3b8bd2f60a3d",
)

http_file(
    name = "postgres-scanner-ext.gz",
    urls = ["http://extensions.duckdb.org/{}/linux_amd64/postgres_scanner.duckdb_extension.gz".format(DUCKDB_VERSION)],
    sha256 = "42e9ba5c2a9f9f77f1415e4cd320295f9623d4c20e09b20687d384a06681e54c",
)

http_file(
    name = "quack-ext.gz",
    urls = ["http://extensions.duckdb.org/{}/linux_amd64/quack.duckdb_extension.gz".format(DUCKDB_VERSION)],
    sha256 = "609be01482fde0bc1d99a64c7ae87134a134638c9c45e39285c64cd57d953f0c",
)

# DuckDB loads extensions offline from <dir>/<version>/<platform>/<name>.duckdb_extension.
# Build exactly that layout so the fixture can `SET extension_directory=` + `LOAD` with no network.
genrule(
    name = "duckdb-extensions",
    out = "extdir",
    cmd = " && ".join([
        "mkdir -p $OUT/{}/linux_amd64".format(DUCKDB_VERSION),
        "gzip -dc $(location :ducklake-ext.gz) > $OUT/{}/linux_amd64/ducklake.duckdb_extension".format(DUCKDB_VERSION),
        "gzip -dc $(location :postgres-scanner-ext.gz) > $OUT/{}/linux_amd64/postgres_scanner.duckdb_extension".format(DUCKDB_VERSION),
        "gzip -dc $(location :quack-ext.gz) > $OUT/{}/linux_amd64/quack.duckdb_extension".format(DUCKDB_VERSION),
    ]),
    labels = ["uses_xz"],
    visibility = ["PUBLIC"],
)

# Runtime migrations dir for sqlx Migrator::new (the compile-time sqlx::migrate!
# macro needs an absolute CARGO_MANIFEST_DIR, which buck2 can't provide). The
# filegroup preserves the glob's "migrations/" prefix, hence the env appends it.
filegroup(
    name = "migrations",
    srcs = glob(["migrations/**/*.sql"]),
    visibility = ["PUBLIC"],
)

# Committed sqlx offline cache for compile-time query! validation. The filegroup
# preserves the glob's ".sqlx/" prefix, so SQLX_OFFLINE_DIR appends it. Generated
# by tools/sqlx-prepare.sh against a freshly-migrated ephemeral postgres.
filegroup(
    name = "sqlx-cache",
    srcs = glob([".sqlx/**"]),
)

rust_library(
    name = "postgres",
    crate = "control_plane_postgres",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    edition = "2024",
    env = {
        # sqlx's offline resolver needs CARGO_MANIFEST_DIR non-empty but never
        # dereferences it once SQLX_OFFLINE_DIR hits first. clippy-driver, however,
        # *does* canonicalize it to locate clippy.toml, so it must be a path that
        # exists in the action sandbox — "." (the package root) always does.
        "CARGO_MANIFEST_DIR": ".",
        "SQLX_OFFLINE": "true",
        "SQLX_OFFLINE_DIR": "$(location :sqlx-cache)/.sqlx",
    },
    # parquet/arrow-ipc/arrow-select are renamed to `<crate>57` in Cargo.toml (two
    # public majors each); named_deps sets the matching buck2 extern crate name so
    # `use parquet57`/`arrow_ipc57`/`arrow_select57` resolve the same under buck2 and
    # cargo (the bare `:<crate>57` aliases' crate attr is the unsuffixed name).
    named_deps = {
        "parquet57": "//third-party:parquet57",
        "arrow_ipc57": "//third-party:arrow-ipc57",
        "arrow_select57": "//third-party:arrow-select57",
    },
    deps = [
        "//src/control-plane/core:core",
        "//third-party:arrow-array",
        "//third-party:arrow-schema",
        "//third-party:async-trait",
        "//third-party:bytes",
        "//third-party:futures",
        "//third-party:hex",
        "//third-party:hmac",
        "//third-party:iceberg",
        "//third-party:object_store",
        "//third-party:reqwest",
        "//third-party:serde",
        "//third-party:serde_json",
        "//third-party:sha2",
        "//third-party:sqlx",
        "//third-party:tempfile",
        "//third-party:thiserror",
        "//third-party:time",
        "//third-party:tokio",
        "//third-party:tracing",
        "//third-party:typetag",
        "//third-party:uuid",
    ],
    visibility = ["PUBLIC"],
)

