load("//platforms:defs.bzl", "RE_TEST_PROPS")
load("@prelude//python:python_wheel.bzl", "python_wheel")

# The wheel version. Kept equal to pyproject.toml [project] version by :wheel-test.
_WHEEL_VERSION = "0.1.0"

python_test(
    name = "imports",
    srcs = ["tests/imports_test.py"],
    # Pinned to the RE executor: the inplace par bakes the hermetic
    # interpreter's absolute path from the (RE) par-build sandbox into its
    # shebang, so a local run cannot exec it. See RE_TEST_PROPS in
    # platforms/defs.bzl and fut-python-par-local-shebang.
    remote_execution = RE_TEST_PROPS,
    deps = [
        "//third-party/python:httpx",
        "//third-party/python:pyarrow",
        "//third-party/python:pydantic",
    ],
)

python_library(
    name = "loom-sdk",
    # base_module = "" places `loom_sdk/` at the link-tree root, so it's
    # importable as top-level `loom_sdk` (matching the published package
    # layout) rather than nested under this BUCK file's package path.
    base_module = "",
    srcs = glob(["loom_sdk/**/*.py"], exclude = ["loom_sdk/pydantic/**"]),
    visibility = ["PUBLIC"],
    deps = [
        "//third-party/python:httpx",
        "//third-party/python:pyarrow",
    ],
)

python_test(
    name = "units",
    srcs = glob(
        ["tests/*_test.py"],
        exclude = [
            "tests/imports_test.py",  # the infra acceptance test — its own :imports target
            "tests/pydantic_*_test.py",  # :units-pydantic (Task 5; needs the pydantic dep)
            "tests/e2e_*_test.py",  # :e2e (Task 7; needs the fixture env)
        ],
    ),
    remote_execution = RE_TEST_PROPS,
    deps = [":loom-sdk"],
)

python_library(
    name = "loom-sdk-pydantic",
    base_module = "",
    srcs = glob(["loom_sdk/pydantic/**/*.py"]),
    visibility = ["PUBLIC"],
    deps = [
        ":loom-sdk",
        "//third-party/python:pydantic",
    ],
)

python_test(
    name = "units-pydantic",
    srcs = [
        "tests/pydantic_apply_test.py",
        "tests/pydantic_mapping_test.py",
    ],
    remote_execution = RE_TEST_PROPS,
    deps = [
        ":loom-sdk",
        ":loom-sdk-pydantic",
    ],
)

# `//src/sdk/PACKAGE` applies the Python cfg modifiers to this whole package, so a
# bare `$(location //src/services/standalone:loom)` from `:e2e`'s `env` would
# reconfigure (and rebuild) the whole Rust tree under that cfg hash. Pin the
# referenced binary explicitly to `prelude//platforms:default` — the actual
# default TARGET platform every `root//...` target (including this one) resolves
# to per `.buckconfig`'s `target_platform_detector_spec` (NOT `root//platforms:
# default`, which `.buckconfig`'s `execution_platforms` uses for the separate
# execution-platform axis) — so this alias reproduces exactly the configuration a
# plain `buck2 build //src/services/standalone:loom` already uses, verified via
# `buck2 cquery //src/services/standalone:loom` matching `buck2 cquery
# "deps(//src/sdk/python:e2e, 1)"`'s entry for it. In-tree precedent for the
# alias mechanism (not this platform choice, which is wasm there):
# `src/ui/e2e/BUCK`'s `:bundle-wasm`.
configured_alias(
    name = "standalone-bin",
    actual = "//src/services/standalone:loom",
    platform = "prelude//platforms:default",
)

# E2E smoke test: boots the real `loom` composite (embedded Postgres, engine +
# ingest + query-api + worker) as a subprocess and drives it entirely over HTTP
# from `loom_sdk.AsyncClient`. Env mirrors the `loom_fixture_test` fixture wiring
# (src/control-plane/postgres/defs.bzl) — copied literally, not reinvented —
# plus `STANDALONE_BIN` via the pinned alias above.
python_test(
    name = "e2e",
    srcs = ["tests/e2e_smoke_test.py"],
    env = {
        "STANDALONE_BIN": "$(location :standalone-bin)",
        "POSTGRES_BIN_DIR": "$(location //src/control-plane/postgres:postgres-bin)/bin",
        "POSTGRES_LD_LIBRARY_PATH": "$(location //src/control-plane/postgres:postgres-bin)/lib:$(location //src/control-plane/postgres:libxml2)",
        "LOOM_PG_FIXTURE_SLOT_DIR": "/tmp/loom-pg-fixture-slots",
    },
    remote_execution = RE_TEST_PROPS,
    deps = [
        ":loom-sdk",
        ":loom-sdk-pydantic",
    ],
)

# Buck2-built distribution wheel (no uv build / PEP 517 backend). Packages the two
# first-party python_library targets; third-party deps stay out and are declared via
# `requires` (emitted as Requires-Dist). `platform = "any"` overrides the toolchain
# default so the tag is py3-none-any (pure Python). Hermetic ⇒ joins the //src/... CI
# sweep. Version MUST match pyproject.toml [project] version — guarded by :wheel-test.
python_wheel(
    name = "wheel",
    dist = "loom-sdk",
    version = _WHEEL_VERSION,
    libraries = [":loom-sdk", ":loom-sdk-pydantic"],
    requires = [
        "httpx>=0.28",
        "pyarrow>=25",
        'pydantic>=2.11; extra == "pydantic"',
    ],
    extra_metadata = {"Provides-Extra": "pydantic"},
    platform = "any",
    visibility = ["PUBLIC"],
)
