load("@prelude//cfg/modifier/cfg_constructor.bzl", "cfg_constructor_pre_constraint_analysis", "cfg_constructor_post_constraint_analysis")
load("@prelude//cfg/modifier/common.bzl", "MODIFIER_METADATA_KEY")
load("@prelude//rust:cargo_package.bzl", "DEFAULT_REINDEER_PLATFORMS", "set_reindeer_platforms")

# Map loom's //platforms:wasm onto reindeer's "wasm32" platform name. That platform
# carries host os/cpu (so exec-side proc-macro/build-script deps resolve) plus the
# custom root//platforms/constraints:wasm32 value; without this mapping the default
# os/cpu select would resolve it to "linux-x86_64" and third-party crates would pull
# their `cfg(not(wasm32))` deps (tokio/socket2) into the wasm graph. Other configs
# fall through to the default os/cpu-based names. Pairs with the [platform.wasm32]
# entry in reindeer.toml (which is what makes reindeer emit the wasm32 deps at all).
set_reindeer_platforms(select({
    "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
    "root//platforms/constraints:wasm32": "wasm32",
}))

# Register the prelude's configuration-modifier cfg constructor so BXL/CLI
# `modifiers = [...]` arguments actually re-configure targets. loom uses this to
# turn on Rust coverage instrumentation for exactly the build path
# tools/coverage/cov.bxl drives (the `//tools/coverage:coverage_enabled`
# constraint_value), with no global config flag. Without a registered cfg
# constructor, `modifiers=` is silently a no-op.
set_cfg_constructor(
    stage0 = cfg_constructor_pre_constraint_analysis,
    stage1 = cfg_constructor_post_constraint_analysis,
    key = MODIFIER_METADATA_KEY,
    aliases = struct(),
    extra_data = struct(),
)
