[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none
  # Container-image / Helm build rules (apko/oci/helm) live in the homelab repo
  # and are consumed as a git EXTERNAL CELL (see [external_cells] below) — buck2
  # fetches the pinned commit into buck-out automatically, so there's no
  # submodule and no vendored copy. The //deploy targets (in the ROOT cell) load
  # them as `homelab//buck2/...`; the rules use only cell-relative //buck2/... and
  # prelude//... refs, so they resolve identically in homelab or here. External
  # cells resolve only from the ROOT cell, which is why //deploy stays under root.
  # The path `homelab` is the cell's nominal location / `buck2 expand-external-cell`
  # target (gitignored, never checked in) — it must NOT reuse the `none` path
  # above, or buck2's path->cell mapping collides and misroutes the `none` cell.
  homelab = homelab

[external_cells]
  homelab = git

[external_cell_homelab]
  git_origin = https://github.com/jomcgi/homelab.git
  # Pinned commit (sha1 required — not a branch/tag). Bump to "publish" a new
  # rules version: point at a newer homelab commit (ideally a tagged release).
  commit_hash = ee8669c3245229eeaf813fff98c271b3345c4e26

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

# Prelude is vendored as a git submodule at `prelude/` (see .gitmodules).
# Pinned to a commit dated alongside the buck2 binary; bump by updating the submodule.

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:homelab//...->prelude//platforms:default

[build]
  execution_platforms = root//platforms:default

[project]
  remote_enabled = true
  # Exclude the affected-CI job's base-commit checkout (.github/workflows/ci.yml
  # checks the PR base out into _base/) from `root//...`. A .buckconfig change
  # otherwise makes btd validate the whole universe, which descends into that
  # nested copy of the prelude and trips latent errors in its android toolchain
  # test BUCKs. Harmless when _base/ doesn't exist (normal builds). The affected
  # job additionally appends `deploy` here at runtime so btd (which can't read the
  # homelab external cell) skips //deploy; buck2 proper builds //deploy normally.
  ignore = _base

[buck2]
digest_algorithms = SHA256

[buck2_re_client]
  engine_address = remote.buildbuddy.io
  action_cache_address = remote.buildbuddy.io
  cas_address = remote.buildbuddy.io
  http_headers = x-buildbuddy-api-key:$BUILDBUDDY_API_KEY
